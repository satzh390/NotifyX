{
  "interactiveLogin": false,
  "tokenCallbacks": [
    {
      "issuerId": "default",
      "tokenExpiry": 3600,
      "requestMappings": [
        {
          "requestParam": "client_id",
          "match": "my-client",
          "claims": {
            "sub": "my-client",
            "aud": ["notifyx-api"],
            "orgId": "acme",
            "scope": "notify:read notify:write"
          }
        }
      ]
    }
  ]
}
