{
  "interactiveLogin": true,
  "tokenCallbacks": [
    {
      "issuerId": "default",
      "tokenExpiry": 3600,
      "requestMappings": [
        {
          "requestParam": "scope",
          "match": ".*",
          "claims": {
            "aud": ["notifyx-api"],
            "orgId": "acme",
            "scope": ["notify:read", "notify:write"]
          }
        }
      ]
    }
  ]
}
